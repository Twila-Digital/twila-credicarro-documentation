{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Credicarro",
  "colors": {
    "primary": "#feb916",
    "light": "#feb916",
    "dark": "#feb916"
  },
  "appearance": {
    "default": "light"
  },
  "openapi": ["/openapi.yaml"],
  "favicon": "/favicon.ico",
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/introduction"
    },
    {
      "source": "/pages/idempotency",
      "destination": "/pages/errors"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Comece aqui",
        "groups": [
          {
            "group": "Comece aqui",
            "pages": ["pages/introduction"]
          }
        ]
      },
      {
        "tab": "Para Desenvolvedores",
        "groups": [
          {
            "group": "Integração",
            "pages": [
              "pages/for-developers",
              "pages/development",
              "pages/errors"
            ]
          }
        ]
      },
      {
        "tab": "Autenticação",
        "groups": [
          {
            "group": "Visão geral",
            "pages": ["pages/authentication"]
          },
          {
            "group": "Autenticação",
            "pages": ["pages/authentication/accesstoken"]
          }
        ]
      },
      {
        "tab": "Proposta",
        "groups": [
          {
            "group": "Fluxo",
            "pages": ["pages/v2/overview", "pages/v2/steps"]
          },
          {
            "group": "Cliente",
            "pages": [
              "pages/customer/unified",
              "pages/customer/create",
              "pages/customer/address",
              "pages/customer/professional"
            ]
          },
          {
            "group": "Simulação",
            "pages": [
              "pages/v2/simulation/range-financing",
              "pages/v2/simulation/range-refinancing",
              "pages/v2/simulation/create-financing",
              "pages/v2/simulation/create-refinancing",
              "pages/simulation/get",
              "pages/simulation/pagination"
            ]
          },
          {
            "group": "Proposta",
            "pages": [
              "pages/v2/proposal/create",
              "pages/v2/proposal/get",
              "pages/v2/proposal/document",
              "pages/v2/proposal/vehicle-detail",
              "pages/v2/proposal/deposit-account",
              "pages/proposal/pagination"
            ]
          },
          {
            "group": "v1 (legado)",
            "pages": [
              "pages/simulation/range-financing",
              "pages/simulation/range-refinancing",
              "pages/simulation/create-financing",
              "pages/simulation/create-refinancing",
              "pages/proposal/create",
              "pages/proposal/get"
            ]
          }
        ]
      },
      {
        "tab": "Webhooks",
        "groups": [
          {
            "group": "Visão geral",
            "pages": ["pages/webhooks", "pages/v2/webhooks"]
          },
          {
            "group": "Segurança",
            "pages": ["pages/webhooks/security"]
          },
          {
            "group": "Webhooks",
            "pages": [
              "pages/webhook/create",
              "pages/webhook/list",
              "pages/webhook/update",
              "pages/webhook/delete"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "llms.txt",
        "href": "/llms.txt"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Credicarro",
      "href": "https://www.credicarro.com.br"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Twila-Digital",
      "linkedin": "https://br.linkedin.com/company/credicarro?trk=public_post_feed-actor-name"
    }
  }
}
